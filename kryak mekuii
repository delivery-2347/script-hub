    local function updateGrabPlayerList(search)
        local items = {}
        search = search or ""
        local searchLower = string.lower(search)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local display = plr.DisplayName .. " | " .. plr.Name
                if search == "" or string.find(string.lower(display), searchLower, 1, true) then
                    table.insert(items, display)
                end
            end
        end
        table.sort(items)
        if grabPlayerDropdown then
            if grabSelected.currentPlayer and grabSelected.currentPlayer.Parent then
                grabPlayerDropdown:Refresh(items, grabSelected.currentPlayer.DisplayName .. " | " .. grabSelected.currentPlayer.Name)
            else
                grabPlayerDropdown:Refresh(items, "")
            end
        end
    end

