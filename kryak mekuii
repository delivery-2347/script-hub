    local function getRemote(name)
        if States.AntiGrab.cached.remotes[name] and States.AntiGrab.cached.remotes[name].Parent then
            return States.AntiGrab.cached.remotes[name]
        end
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj.Name == name and obj:IsA("RemoteEvent") then
                States.AntiGrab.cached.remotes[name] = obj
                return obj
            end
        end
        local grab = ReplicatedStorage:FindFirstChild("GrabEvents")
        if grab then
            for _, obj in ipairs(grab:GetDescendants()) do
                if obj.Name == name and obj:IsA("RemoteEvent") then
                    States.AntiGrab.cached.remotes[name] = obj
                    return obj
                end
            end
        end
        return nil
    end

