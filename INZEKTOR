local Tabs = {}

local CurrentTab = nil

local Updating = false
local LoadingTab = false

--==================================================
-- CREATE TAB
--==================================================

local function CreateTab(
    name,
    code
)

    if #Tabs >= MAX_TABS then
        return nil
    end

    local tab = {

        Name =
            name
            or
            ("Script " ..
                tostring(
                    #Tabs + 1
                )),

        Code =
            code or "",

        Index =
            #Tabs + 1,

    }

    table.insert(
        Tabs,
        tab
    )

    return tab
end

--==================================================
-- UPDATE EDITOR
--==================================================

local function UpdateEditor()

    if Updating then
        return
    end

    if not CurrentTab then
        return
    end

    Updating = true

    local code =
        TextBox.Text
            :gsub(
                "\r\n",
                "\n"
            )
            :gsub(
                "\r",
                "\n"
            )

    CurrentTab.Code =
        code

    --==============================================
    -- LINE NUMBERS
    --==============================================

    local lines =
        string.split(
            code,
            "\n"
        )

    local lineCount =
        math.max(
            #lines,
            1
        )

    local numbers = {}

    for i = 1, lineCount do

        numbers[i] =
            tostring(i)

    end

    LineNumbers.Text =
        table.concat(
            numbers,
            "\n"
        )

    --==============================================
    -- SYNTAX
    --==============================================

    HighlightLabel.Text =
        HighlightCode(code)

    --==============================================
    -- SIZE
    --==============================================

    local longest = 1

    for _, line in ipairs(lines) do

        if #line > longest then
            longest = #line
        end

    end

    local width =
        math.max(
            700,
            longest * 8 + 40
        )

    local height =
        math.max(
            500,
            lineCount * 18 + 20
        )

    HighlightLabel.Size =
        UDim2.fromOffset(
            width,
            height
        )

    TextBox.Size =
        UDim2.fromOffset(
            width,
            height
        )

    LineNumbers.Size =
        UDim2.fromOffset(
            45,
            height
        )

    Scroll.CanvasSize =
        UDim2.fromOffset(
            width + 30,
            height + 30
        )

    Updating = false

end

