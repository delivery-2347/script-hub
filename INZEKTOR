                        tab.Name,

                    TextColor3 =
                        tab ==
                        CurrentTab
                        and
                        C.Green
                        or
                        C.Text,

                    TextSize =
                        11,

                    Font =
                        Enum.Font.GothamMedium,

                    TextXAlignment =
                        Enum.TextXAlignment.Left,
                },
                button
            )

        local close =
            New(
                "TextButton",
                {
                    Position =
                        UDim2.new(
                            1,
                            -25,
                            0,
                            0
                        ),

                    Size =
                        UDim2.fromOffset(
                            24,
                            29
                        ),

                    BackgroundTransparency =
                        1,

                    Text = "×",

                    TextColor3 =
                        C.Muted,

                    TextSize =
                        14,

                    Font =
                        Enum.Font.GothamBold,

                    BorderSizePixel =
                        0,
                },
                button
            )

        --==========================================
        -- SELECT TAB
        --==========================================

        button.MouseButton1Click:Connect(
            function()

                SwitchTab(tab)

                RefreshTabs()

            end
        )

        --==========================================
        -- CLOSE TAB
        --==========================================

        close.MouseButton1Click:Connect(
            function()

                if CurrentTab then

                    CurrentTab.Code =
                        TextBox.Text

                    SaveTabFile(
                        CurrentTab.Index,
                        CurrentTab.Code
                    )

                end

                local removedIndex

                for i, t in ipairs(
                    Tabs
                ) do

                    if t == tab then

                        removedIndex =
                            i

                        break

                    end

                end

                if not removedIndex then
                    return
                end

                table.remove(
                    Tabs,
                    removedIndex
                )

                --==================================
                -- REINDEX
                --==================================

                for i, t in ipairs(
                    Tabs
                ) do

                    t.Index = i

                end

                --==================================
                -- REMOVE FILE
                --==================================

                if FSAvailable() then

                    pcall(function()

                        if isfile(
                            TabFile(
                                removedIndex
                            )
                        ) then

                            delfile(
                                TabFile(
                                    removedIndex
                                )
                            )

                        end

                    end)

                end

                --==================================
                -- NO TABS
                --==================================

                if #Tabs == 0 then

                    local newTab =
                        CreateTab(
                            "Script 1",
                            ""
                        )

                    CurrentTab =
                        newTab

                    LoadingTab =
                        true

                    TextBox.Text =
                        ""

                    LoadingTab =
                        false

                --==================================
                -- ACTIVE TAB CLOSED
                --==================================

                elseif CurrentTab == tab then

                    local newIndex =
                        math.clamp(
                            removedIndex,
                            1,
                            #Tabs
                        )

                    CurrentTab =
                        Tabs[
                            newIndex
                        ]

                    LoadingTab =
                        true

                    TextBox.Text =
                        CurrentTab.Code

                    LoadingTab =
                        false

                end

                SaveTabCount(
                    #Tabs
                )

                Scroll.CanvasPosition =
                    Vector2.new(
                        0,
                        0
                    )

                UpdateEditor()

                RefreshTabs()

            end
        )

    end

end

