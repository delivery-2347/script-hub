    local function updatePlayerList(search)
        local items = {}
        local found = false
        search = search or ""
        local searchLower = string.lower(search)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local display = plr.DisplayName .. " | " .. plr.Name
                if search == "" then
                    table.insert(items, display)
                    found = true
                elseif string.find(string.lower(display), searchLower, 1, true) then
                    table.insert(items, display)
                    found = true
                end
            end
        end
        table.sort(items)
        if playerDropdown then
            if selected.currentPlayer and selected.currentPlayer.Parent then
                local curDisplay = selected.currentPlayer.DisplayName .. " | " .. selected.currentPlayer.Name
                if search == "" then
                    playerDropdown:Refresh(items, curDisplay)
                else
                    playerDropdown:Refresh(items, "")
                end
            else
                playerDropdown:Refresh(items, "")
            end
        end
        if not found and search ~= "" then
            Notify("Search", "No players found with: " .. search, 1)
        end
    end

