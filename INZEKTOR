--==================================================
-- FILE SYSTEM
--==================================================

local function FSAvailable()
    return type(makefolder) == "function"
        and type(writefile) == "function"
        and type(readfile) == "function"
        and type(isfile) == "function"
        and type(isfolder) == "function"
end

local HasFS = FSAvailable()

local function EnsureFolders()
    if not HasFS then
        return
    end

    pcall(function()
        if not isfolder(SAVE_ROOT) then
            makefolder(SAVE_ROOT)
        end

        if not isfolder(SAVE_TABS) then
            makefolder(SAVE_TABS)
        end
    end)
end

EnsureFolders()

local function TabPath(id)
    return SAVE_TABS .. "/Script_" .. tostring(id) .. ".lua"
end

local function LoadFile(id)
    if not HasFS then
        return ""
    end

    local value = ""

    pcall(function()
        if isfile(TabPath(id)) then
            value = readfile(TabPath(id)) or ""
        end
    end)

    return value
end

local function SaveFile(id, text)
    if not HasFS then
        return false
    end

    local ok = false

    pcall(function()
        writefile(TabPath(id), text or "")
        ok = true
    end)

    return ok
end

local function DeleteFile(id)
    if type(delfile) ~= "function" then
        return
    end

    pcall(function()
        if isfile(TabPath(id)) then
            delfile(TabPath(id))
        end
    end)
end

local function FindFreeId()
    for id = 1, MAX_TABS do
        if not HasFS or not isfile(TabPath(id)) then
            return id
        end
    end

    return nil
end

