                local start = tick()
                if SetNetworkOwner then
                    SetNetworkOwner:FireServer(rootTarget, rootTarget.CFrame)
                end
                task.wait()
                if tick() - start > 0.3 then
                    if humTarget.Health > 0 then
                        for _ = 1, 5 do
                            if DestroyGrabLine then
                                DestroyGrabLine:FireServer(rootTarget)
                            end
                        end
                        humTarget.Health = 0
                    end
                    task.wait()
                    rootLocal.CFrame = originalCF
                    rootLocal.Velocity = Vector3.new(0,0,0)
                end
            end)
        end
