    local function setupPacketLag()
        local remote = GrabEvents:WaitForChild("ExtendGrabLine")
        remote.OnClientEvent:Connect(function(player, data)
            if not player then return end
            local size = 0
            if type(data) == "table" then
                for _, v in pairs(data) do
                    if type(v) == "number" then
                        size = size + math.abs(v)
                    elseif type(v) == "string" then
                        size = size + #v
                    end
                end
            elseif type(data) == "number" then
                size = math.abs(data)
            elseif type(data) == "string" then
                size = #data
            end
            if size > 999 and size < 200000000 then
                local last = PacketLagDetector.detectedPlayers[player]
                if not last or tick() - last > PacketLagDetector.cooldown then
                    PacketLagDetector.detectedPlayers[player] = tick()
                    Notify("PACKET LAG DETECTED", player.DisplayName .. " | " .. player.Name .. " Send " .. math.floor(size) .. " Packets", 4)
                    PlaySound(Sounds.PacketLag)
                end
            end
        end)
    end
    _G.setupPacketLag = setupPacketLag

