--==================================================
-- FILE SYSTEM
--==================================================

local function FSAvailable()
    return makefolder
        and writefile
        and readfile
        and isfile
        and isfolder
end

if FSAvailable() then

    pcall(function()

        if not isfolder(SAVE_FOLDER) then
            makefolder(SAVE_FOLDER)
        end

        if not isfolder(TABS_FOLDER) then
            makefolder(TABS_FOLDER)
        end

    end)

end

local function TabFile(index)
    return TABS_FOLDER .. "/Script_" .. tostring(index) .. ".lua"
end

local function CountFile()
    return SAVE_FOLDER .. "/tabs.txt"
end

local function SaveTabFile(index, code)

    if not FSAvailable() then
        return
    end

    pcall(function()
        writefile(
            TabFile(index),
            code or ""
        )
    end)

end

local function LoadTabFile(index)

    if not FSAvailable() then
        return ""
    end

    local result = ""

    pcall(function()

        if isfile(TabFile(index)) then
            result = readfile(
                TabFile(index)
            )
        end

    end)

    return result
end

local function SaveTabCount(count)

    if not FSAvailable() then
        return
    end

    pcall(function()

        writefile(
            CountFile(),
            tostring(count)
        )

    end)

end

local function LoadTabCount()

    if not FSAvailable() then
        return 1
    end

    local count = 1

    pcall(function()

        if isfile(CountFile()) then

            local value =
                tonumber(
                    readfile(CountFile())
                )

            if value then
                count = math.clamp(
                    math.floor(value),
                    1,
                    MAX_TABS
                )
            end

        end

    end)

    return count
end

