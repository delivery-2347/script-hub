ClearBtn.Font              = Enum.Font.GothamBold
ClearBtn.BorderSizePixel   = 0
ClearBtn.Parent            = Window
Instance.new("UICorner", ClearBtn).CornerRadius = UDim.new(0, 6)
ClearBtn.MouseButton1Click:Connect(function()
    ScriptBox.Text = ""
end)

local ExecBtn = Instance.new("TextButton")
ExecBtn.Text              = "▶  Execute"
ExecBtn.Size              = UDim2.new(1, -120, 0, 30)
ExecBtn.Position          = UDim2.new(0, 110, 1, -44)
ExecBtn.BackgroundColor3  = CUCUMBER.ElementColor
ExecBtn.TextColor3        = CUCUMBER.SchemeColor
ExecBtn.TextSize          = 14
ExecBtn.Font              = Enum.Font.GothamBold
ExecBtn.BorderSizePixel   = 0
ExecBtn.Parent            = Window
Instance.new("UICorner", ExecBtn).CornerRadius = UDim.new(0, 6)
Instance.new("UIStroke", ExecBtn).Color = CUCUMBER.SchemeColor

ExecBtn.MouseButton1Click:Connect(function()
    local code = ScriptBox.Text
    if code == "" then return end
    local ok, err = pcall(loadstring(code))
    if not ok then
        warn("[Cucumber] Ошибка: " .. tostring(err))
    end
end)

local dragging, dragStart, startPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging  = true
        dragStart = input.Position
        startPos  = Window.Position
    end
end)
Header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Window.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
        Window.Visible = not Window.Visible
    end
end)
