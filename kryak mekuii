    local lineCounts = {}
    local lineLastReset = tick()
    local lineLastNotify = {}
    local CHECK_INTERVAL = 1
    local LINE_THRESHOLD = 100

    CreateGrabLine.OnClientEvent:Connect(function(player)
        if not player or player == LocalPlayer then return end
        lineCounts[player] = (lineCounts[player] or 0) + 1
        local now = tick()
        if now - lineLastReset > CHECK_INTERVAL then
            local rates = {}
            for p, count in pairs(lineCounts) do
                rates[p] = math.floor(count / CHECK_INTERVAL)
                if rates[p] > LINE_THRESHOLD then
                    local last = lineLastNotify[p]
                    if not last or tick() - last > 6 then
                        lineLastNotify[p] = tick()
                        Notify("LINE LAG DETECTED", p.DisplayName .. " | " .. p.Name .. " Spamming (" .. rates[p] .. " lines/sec)", 3)
                        PlaySound(Sounds.LineLag)
                    end
                end
            end
            for p in pairs(lineCounts) do
                lineCounts[p] = nil
            end
            lineLastReset = tick()
        end
    end)

