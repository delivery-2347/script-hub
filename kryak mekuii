    local function spawnPallet()
        if not CanSpawnToy or not CanSpawnToy.Value then return nil end
        local char = LocalPlayer.Character
        if not char then return nil end
        local head = char:FindFirstChild("Head")
        if not head then return nil end
        local pos = head.CFrame * CFrame.new(0, 5, 0)
        local remote = MenuToys:WaitForChild("SpawnToyRemoteFunction")
        local success, result = pcall(function()
            return remote:InvokeServer("PalletLightBrown", pos, Vector3.new(0, -90, 0))
        end)
        if success then
            return result
        end
        return nil
    end

    local function forcePallet(pallet)
        if not pallet then return end
        palletState.currentPallet = pallet
        if palletState.connection then palletState.connection:Disconnect() end
        palletState.connection = RunService.Heartbeat:Connect(function()
            if not palletState.enabled then return end
            if not pallet or not pallet.Parent then return end
            local soundPart = pallet:FindFirstChild("SoundPart")
            if not soundPart then return end
            local owner = soundPart:FindFirstChild("PartOwner")
            if not owner or owner.Value ~= LocalPlayer.Name then
                if SetNetworkOwner then
                    SetNetworkOwner:FireServer(soundPart, soundPart.CFrame)
                end
            end
            soundPart.AssemblyLinearVelocity = Vector3.new(0, 1e9, 0)
            soundPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
            for _, part in ipairs(pallet:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 1
                    part.CanCollide = false
                    part.CanQuery = false
                end
            end
        end)
    end

    local function startPermanentPallet()
        if palletState.enabled then return end
        palletState.enabled = true

        -- Monitor for pallet spawn
        local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if folder then
            folder.ChildAdded:Connect(function(child)
                if palletState.enabled and child.Name == "PalletLightBrown" then
                    if not palletState.currentPallet then
                        forcePallet(child)
                    end
                end
            end)
            folder.ChildRemoved:Connect(function(child)
                if palletState.enabled and (child == palletState.currentPallet or child == palletState.myPalletId) then
                    palletState.currentPallet = nil
                    palletState.myPalletId = nil
                    task.wait()
                    if palletState.enabled then
                        local newPallet = spawnPallet()
                        if newPallet then
                            forcePallet(newPallet)
                        end
                    end
                end
            end)
        end

        palletState.thread = task.spawn(function()
            while palletState.enabled do
                local char = LocalPlayer.Character
                if not char then
                    task.wait()
                else
                    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                    if not folder then
                        task.wait()
                    elseif not folder:FindFirstChild("PalletLightBrown") then
                        if CanSpawnToy and CanSpawnToy.Value then
                            local pallet = spawnPallet()
                            if pallet then
                                forcePallet(pallet)
                            end
                        end
                    end
                end
                task.wait()
            end
        end)
    end

    local function stopPermanentPallet()
        palletState.enabled = false
        if palletState.connection then
            palletState.connection:Disconnect()
            palletState.connection = nil
        end
        if palletState.ownerhipCheckConnection then
            palletState.ownerhipCheckConnection:Disconnect()
            palletState.ownerhipCheckConnection = nil
        end
        if palletState.thread then
            task.cancel(palletState.thread)
            palletState.thread = nil
        end
        if palletState.currentPallet and palletState.currentPallet.Parent then
            pcall(function()
                DestroyToy:FireServer(palletState.currentPallet)
            end)
        end
        palletState.currentPallet = nil
        palletState.myPalletId = nil
    end

