--==================================================
-- SWITCH TAB
--==================================================

local function SwitchTab(tab)

    if not tab then
        return
    end

    if CurrentTab == tab then
        return
    end

    -- save old
    if CurrentTab then

        CurrentTab.Code =
            TextBox.Text

        SaveTabFile(
            CurrentTab.Index,
            CurrentTab.Code
        )

    end

    CurrentTab = tab

    LoadingTab = true

    TextBox.Text =
        tab.Code or ""

    LoadingTab = false

    Scroll.CanvasPosition =
        Vector2.new(
            0,
            0
        )

    UpdateEditor()

end

