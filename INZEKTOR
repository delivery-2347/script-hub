--==================================================
-- HELPERS
--==================================================

local function New(
    class,
    props,
    parent
)

    local obj =
        Instance.new(class)

    for key, value in pairs(
        props or {}
    ) do
        obj[key] = value
    end

    obj.Parent = parent

    return obj
end

local function Corner(
    obj,
    radius
)

    local c =
        Instance.new("UICorner")

    c.CornerRadius =
        UDim.new(
            0,
            radius or 6
        )

    c.Parent = obj

    return c
end

local function Stroke(
    obj,
    color,
    thickness,
    transparency
)

    local s =
        Instance.new("UIStroke")

    s.Color = color
    s.Thickness =
        thickness or 1

    s.Transparency =
        transparency or 0

    s.Parent = obj

    return s
end

local function RGB(color)

    return string.format(
        "rgb(%d,%d,%d)",
        math.floor(
            color.R * 255
        ),
        math.floor(
            color.G * 255
        ),
        math.floor(
            color.B * 255
        )
    )

end

local function Escape(text)

    return tostring(text)
        :gsub("&", "&amp;")
        :gsub("<", "&lt;")
        :gsub(">", "&gt;")

end

local function Paint(
    text,
    color
)

    return
        '<font color="' ..
        RGB(color) ..
        '">' ..
        Escape(text) ..
        "</font>"

end

--==================================================
-- LUA SYNTAX
--==================================================

local Keywords = {

    ["and"] = true,
    ["break"] = true,
    ["do"] = true,
    ["else"] = true,
    ["elseif"] = true,
    ["end"] = true,

    ["for"] = true,
    ["function"] = true,
    ["if"] = true,

    ["in"] = true,

    ["local"] = true,
    ["not"] = true,
    ["or"] = true,

    ["repeat"] = true,
    ["return"] = true,

    ["then"] = true,
    ["until"] = true,
    ["while"] = true,

}

local Special = {

    ["true"] = C.Boolean,
    ["false"] = C.Boolean,
    ["nil"] = C.Boolean,

}

local function HighlightLine(line)

    local result = {}

    local i = 1
    local length = #line

    while i <= length do

        local char =
            line:sub(i, i)

        -- COMMENT

        if line:sub(
            i,
            i + 1
        ) == "--" then

            result[#result + 1] =
                Paint(
                    line:sub(i),
                    C.Comment
                )

            break
        end

        -- DOUBLE STRING

        if char == '"' then

            local start = i

            i += 1

            while i <= length do

                local c =
                    line:sub(i, i)

                if c == "\\" then

                    i += 2

                elseif c == '"' then

                    i += 1
                    break

                else

                    i += 1

                end

            end

            result[#result + 1] =
                Paint(
                    line:sub(
                        start,
                        i - 1
                    ),
                    C.String
                )

            continue
        end

        -- SINGLE STRING

        if char == "'" then

            local start = i

            i += 1

            while i <= length do

                local c =
                    line:sub(i, i)

                if c == "\\" then

                    i += 2

                elseif c == "'" then

                    i += 1
                    break

                else

                    i += 1

                end

            end

            result[#result + 1] =
                Paint(
                    line:sub(
                        start,
                        i - 1
                    ),
                    C.String
                )

            continue
        end

        -- NUMBER

        if char:match("%d") then

            local start = i

            while
                i <= length
                and line:sub(
                    i,
                    i
                ):match("[%d%.]")
            do

                i += 1

            end

            result[#result + 1] =
                Paint(
                    line:sub(
                        start,
                        i - 1
                    ),
                    C.Number
                )

            continue
        end

        -- WORD

        if char:match("[%a_]") then

            local start = i

            while
                i <= length
                and line:sub(
                    i,
                    i
                ):match("[%w_]")
            do

                i += 1

            end

            local word =
                line:sub(
                    start,
                    i - 1
                )

            if Special[word] then

                result[#result + 1] =
                    Paint(
                        word,
                        Special[word]
                    )

            elseif Keywords[word] then

                result[#result + 1] =
                    Paint(
                        word,
                        C.Keyword
                    )

            else

                local rest =
                    line:sub(i)

                if rest:match(
                    "^%s*%("
                ) then

                    result[#result + 1] =
                        Paint(
                            word,
                            C.Function
                        )

                else

                    result[#result + 1] =
                        Escape(word)

                end

            end

            continue
        end

        -- OPERATORS

        if char:match(
            "[=<>~%+%-%*/%^%%]"
        ) then

            result[#result + 1] =
                Paint(
                    char,
                    C.Operator
                )

            i += 1

            continue
        end

        -- NORMAL CHARACTER

        result[#result + 1] =
            Escape(char)

        i += 1

    end

    return table.concat(
        result
    )

end


local function HighlightCode(code)

    code =
        code:gsub(
            "\r\n",
            "\n"
        )

    code =
        code:gsub(
            "\r",
            "\n"
        )

    local lines =
        string.split(
            code,
            "\n"
        )

    local output = {}

    for _, line in ipairs(lines) do

        output[#output + 1] =
            HighlightLine(line)

    end

    return table.concat(
        output,
        "\n"
    )

end

