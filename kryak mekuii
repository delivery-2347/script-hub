    local function startLoopWalk()
        if loopWalkEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        loopWalkPosition = hrp.CFrame
        loopWalkEnabled = true
        loopWalkThread = task.spawn(function()
