    local function spawnToy(name)
        local canSpawn = LocalPlayer:WaitForChild("CanSpawnToy")
        while not canSpawn.Value do
            if not antiKickState.enabled or tick() - tick() > 5 then return nil end
            task.wait()
        end
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local remote = MenuToys:WaitForChild("SpawnToyRemoteFunction")
                local success, result = pcall(function()
                    return remote:InvokeServer(name, root.CFrame * CFrame.new(0, 12, 20), Vector3.new(0,0,0))
                end)
                if success then
                    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                    if folder then
                        return folder:WaitForChild(name, 2)
                    end
                end
            end
        end
        return nil
    end

    local function startAntiKick()
        if antiKickState.enabled then return end
        antiKickState.enabled = true

        local charAdded = LocalPlayer.CharacterAdded:Connect(function()
            task.wait()
            if antiKickState.enabled then
                clearKunai()
            end
        end)
        table.insert(antiKickState.connections, charAdded)

        antiKickState.antiKickThread = task.spawn(function()
            while antiKickState.enabled do
                task.wait()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                    clearKunai()
                    task.wait()
                else
                    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                    local shuriken = folder and folder:FindFirstChild("NinjaShuriken")
                    if not shuriken then
                        -- Check if in plot
                        local inPlot = false
                        local plotItem = Workspace.PlotItems.PlayersInPlots:FindFirstChild(LocalPlayer.Name)
                        if plotItem then
                            for _, plot in ipairs(Workspace.Plots:GetChildren()) do
                                local sign = plot:FindFirstChild("PlotSign")
                                if sign then
                                    for _, owner in ipairs(sign:GetChildren()) do
                                        if owner:IsA("StringValue") and owner.Value == LocalPlayer.Name then
                                            inPlot = true
                                            break
                                        end
                                    end
                                end
                                if inPlot then break end
                            end
                        end
                        if inPlot then
                            shuriken = spawnToy("NinjaShuriken")
                            if shuriken then
                                shuriken.Name = "AntiKick"
                                stickKunai(shuriken)
                            end
                        else
                            shuriken = spawnToy("NinjaShuriken")
                            if shuriken then
                                shuriken.Name = "AntiKick"
                                stickKunai(shuriken)
                            end
                        end
                    else
                        -- Ensure shuriken is attached and near player
                        local sticky = shuriken:FindFirstChild("StickyPart")
                        if sticky then
                            local weld = sticky:FindFirstChild("StickyWeld")
                            if not weld or not weld.Part1 then
                                stickKunai(shuriken)
                            end
                        end
                        if shuriken and (char.HumanoidRootPart.Position - shuriken.StickyPart.Position).Magnitude > 30 then
                            clearKunai()
                        end
                    end
                end
            end
        end)
    end

