    local function getClosestPlayer()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
        local localPos = char.HumanoidRootPart.Position
        local closest = nil
        local dist = math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local d = (root.Position - localPos).Magnitude
                    if d < dist then
                        dist = d
                        closest = plr
                    end
                end
            end
        end
        return closest
    end

    local function grabAimTarget(player)
        if not grabAimEnabled then return end
        if not player then
            player = grabSelected.grabPlayer or getClosestPlayer()
        end
        if player and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                Workspace.CurrentCamera.CFrame = CFrame.new(Workspace.CurrentCamera.CFrame.Position, root.Position)
                if not grabAimClick then
                    grabAimClick = true
                    mouse1click()
                    grabAimClick = false
                end
            end
        end
    end

