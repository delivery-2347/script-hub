Execute.MouseButton1Click:Connect(function()
    local code = TextBox.Text

    if code == "" then
        SetStatus("Empty", Color3.fromRGB(220, 160, 80))
        return
    end

    if type(loadstring) ~= "function" then
        SetStatus("No loadstring", Color3.fromRGB(220, 90, 90))
        return
    end

    if CurrentTab then
        CurrentTab.Code = code
        SaveTab(CurrentTab)
    end

    SetStatus("Executing...", C.Green)

    task.spawn(function()
        local okCompile, fn = pcall(loadstring, code)

        if not okCompile or type(fn) ~= "function" then
            SetStatus("Syntax Error", Color3.fromRGB(230, 80, 80))
            warn("[INZEKTOR]", fn)
            return
        end

        local okRun, result = pcall(fn)

        if okRun then
            SetStatus("Executed", C.Green)
        else
            SetStatus("Runtime Error", Color3.fromRGB(230, 80, 80))
            warn("[INZEKTOR]", result)
        end
    end)
end)

