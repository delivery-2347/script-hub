local ClearBtn = Instance.new("TextButton")
ClearBtn.Text              = "Clear"
ClearBtn.Size              = UDim2.new(0, 90, 0, 30)
ClearBtn.Position          = UDim2.new(0, 10, 1, -44)
ClearBtn.BackgroundColor3  = CUCUMBER.ElementColor
