-- 2. ЛОГИКА ЦИКЛА И РАБОЧИЙ КИЛЛ
local selectedPlayer = nil    -- Сюда сохраняется сам Объект Игрока из Players
local autoKillEnabled = false -- Статус тумблера

-- Постоянный цикл отслеживания и респавна
local function startAutoKillLoop()
	task.spawn(function()
		while autoKillEnabled do
			-- Проверяем, что игрок выбран и он все еще в игре
			if selectedPlayer and selectedPlayer.Parent == Players then
				local targetCharacter = selectedPlayer.Character
				
				if targetCharacter then
					local abekt = targetCharacter:FindFirstChild("HumanoidRootPart")
					local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
					
					local myCharacter = LocalPlayer.Character
					local HRP = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
					
					-- Атакуем только если цель жива и у вас есть HRP
					if abekt and HRP and humanoid and humanoid.Health > 0 then
						local lastpozisn = HRP.CFrame
						
						-- ТЕЛЕПОРТ К ЦЕЛИ И АКТИВАЦИЯ ИВЕНТОВ ИЗ ВАШЕГО КОДА
						HRP.CFrame = abekt.CFrame * CFrame.new(0, 0, 2)
						task.wait(0.3)
						
						CreateGrabLine:FireServer(abekt, abekt.CFrame) 
						SetNetworkOwner:FireServer(abekt, abekt.CFrame) 
						DestroyGrabLine:FireServer(abekt) 
						
						task.wait(0.3)
						-- СБРОС ТЕЛА В БЕЗДНУ
						abekt.CFrame = CFrame.new(-785.244995, -91, -71.9565201)
						
						task.wait(0.1)
						-- ВОЗВРАТ НАЗАД
						HRP.CFrame = lastpozisn
						
						-- Задержка 4 секунды, чтобы дать серверу засчитать смерть и не спамить во время респавна
						task.wait(4)
					end
				end
			end
			-- Интервал проверки появления живой цели
			task.wait(0.3)
		end
	end)
end

-- Функция обновления списка игроков
local function updateDropdown()
	for _, child in pairs(dropdownFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 30)
			btn.Text = player.Name
			btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			btn.TextColor3 = Color3.fromRGB(230, 230, 230)
			btn.Font = Enum.Font.SourceSans
			btn.TextSize = 14
			btn.ZIndex = 6
			btn.Parent = dropdownFrame

			local pCorner = Instance.new("UICorner")
			pCorner.CornerRadius = UDim.new(0, 4)
			pCorner.Parent = btn

			btn.MouseButton1Click:Connect(function()
				selectedPlayer = player -- Передаем игрока в цикл
				selectedBox.Text = player.Name
				dropdownFrame.Visible = false
				print("Авто-цель успешно установлена на: " .. player.Name)
			end)
		end
	end
	
	dropdownFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
end

-- Клик по полю выбора игрока
selectedBox.MouseButton1Click:Connect(function()
	if not dropdownFrame.Visible then
		updateDropdown()
	end
	dropdownFrame.Visible = not dropdownFrame.Visible
end)

