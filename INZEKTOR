-- RIGHT SHIFT
--==================================================

UIS.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.RightShift then
        Window.Visible = not Window.Visible
    end
end)

--==================================================
-- FINAL
--==================================================

SetStatus(HasFS and "Saved" or "Memory only", HasFS and C.Green or C.Muted)
print("[INZEKTOR] Clean edition loaded")
