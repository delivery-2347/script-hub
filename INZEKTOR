--==================================================
-- TAB DATA
--==================================================

local Tabs = {}
local CurrentTab = nil
local Updating = false
local LoadingTab = false
local SaveSerial = 0

local function CreateTab(id, name, code)
    if #Tabs >= MAX_TABS then
        return nil
    end

    local tab = {
        Id = id,
        Name = name or ("Script " .. tostring(id)),
        Code = code or "",
    }

    Tabs[#Tabs + 1] = tab
    return tab
end

local function SaveTab(tab)
    if not tab then
        return
    end

    if SaveFile(tab.Id, tab.Code or "") then
        SetStatus("Saved", C.Green)
    end
end

local function QueueSave(tab)
    if not HasFS or not tab then
        return
    end

    SaveSerial = SaveSerial + 1
    local serial = SaveSerial

    task.delay(0.35, function()
        if serial ~= SaveSerial then
            return
        end

        if tab then
            SaveFile(tab.Id, tab.Code or "")
            SetStatus("Saved", C.Green)
        end
    end)
end

--==================================================
-- EDITOR UPDATE
--==================================================

local function UpdateEditor()
    if Updating or not CurrentTab then
        return
    end

    Updating = true

    local code = TextBox.Text or ""
    CurrentTab.Code = code

    local normalized = code:gsub("\r\n", "\n"):gsub("\r", "\n")
    local lines = string.split(normalized, "\n")
    local lineCount = math.max(#lines, 1)

    local numbers = {}
    local longest = 1

    for i = 1, lineCount do
        numbers[i] = tostring(i)

        if #lines[i] > longest then
            longest = #lines[i]
        end
    end

    LineNumbers.Text = table.concat(numbers, "\n")
    HighlightLabel.Text = HighlightCode(normalized)

    local width = math.max(700, longest * 8 + 40)
    local height = math.max(500, lineCount * 18 + 20)

    HighlightLabel.Size = UDim2.fromOffset(width, height)
    TextBox.Size = UDim2.fromOffset(width, height)
    LineNumbers.Size = UDim2.fromOffset(LineWidth - 7, height)

    Scroll.CanvasSize = UDim2.fromOffset(width + 20, height + 20)
    LineScroll.CanvasSize = UDim2.fromOffset(0, height + 20)

    Updating = false
end

TextBox:GetPropertyChangedSignal("Text"):Connect(function()
    if LoadingTab then
        return
    end

    if CurrentTab then
        CurrentTab.Code = TextBox.Text
        QueueSave(CurrentTab)
    end

    UpdateEditor()
end)

-- Keep line numbers vertically synchronized with the code.
Scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
    local p = Scroll.CanvasPosition
    LineScroll.CanvasPosition = Vector2.new(0, p.Y)
end)

--==================================================
-- TAB SWITCHING
--==================================================

local function SwitchTab(tab)
    if not tab or tab == CurrentTab then
        return
    end

    if CurrentTab then
        CurrentTab.Code = TextBox.Text
        SaveTab(CurrentTab)
    end

    CurrentTab = tab
    LoadingTab = true
    TextBox.Text = tab.Code or ""
    LoadingTab = false

    Scroll.CanvasPosition = Vector2.new(0, 0)
    LineScroll.CanvasPosition = Vector2.new(0, 0)

    UpdateEditor()
end

local function RefreshTabs()
    for _, child in ipairs(TabsScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for index, tab in ipairs(Tabs) do
        local width = math.max(105, #tab.Name * 7 + 40)

        local button = New("TextButton", {
            Size = UDim2.fromOffset(width, 29),
            BackgroundColor3 = tab == CurrentTab and C.ButtonHover or C.Button,
            Text = "",
            BorderSizePixel = 0,
            AutoButtonColor = false,
            LayoutOrder = index,
        }, TabsScroll)

        Corner(button, 5)

        New("TextLabel", {
            Position = UDim2.fromOffset(8, 0),
            Size = UDim2.new(1, -30, 1, 0),
            BackgroundTransparency = 1,
            Text = tab.Name,
            TextColor3 = tab == CurrentTab and C.Green or C.Text,
            TextSize = 11,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, button)

        local close = New("TextButton", {
            Position = UDim2.new(1, -25, 0, 0),
            Size = UDim2.fromOffset(24, 29),
            BackgroundTransparency = 1,
            Text = "×",
            TextColor3 = C.Muted,
            TextSize = 14,
            Font = Enum.Font.GothamBold,
            BorderSizePixel = 0,
        }, button)

        button.MouseButton1Click:Connect(function()
            SwitchTab(tab)
            RefreshTabs()
        end)

        close.MouseButton1Click:Connect(function()
            if CurrentTab then
                CurrentTab.Code = TextBox.Text
                SaveTab(CurrentTab)
            end

            local removedIndex
            for i = 1, #Tabs do
                if Tabs[i] == tab then
                    removedIndex = i
                    break
                end
            end

            if not removedIndex then
                return
            end

            DeleteFile(tab.Id)
            table.remove(Tabs, removedIndex)

            if #Tabs == 0 then
                local id = FindFreeId() or 1
                CurrentTab = CreateTab(id, "Script " .. tostring(id), "")
            elseif CurrentTab == tab then
                CurrentTab = Tabs[math.clamp(removedIndex, 1, #Tabs)]
            end

            LoadingTab = true
            TextBox.Text = CurrentTab.Code or ""
            LoadingTab = false

            Scroll.CanvasPosition = Vector2.new(0, 0)
            LineScroll.CanvasPosition = Vector2.new(0, 0)

            RefreshTabs()
            UpdateEditor()
        end)
    end
end

AddTab.MouseButton1Click:Connect(function()
    if #Tabs >= MAX_TABS then
        SetStatus("Max tabs", Color3.fromRGB(220, 160, 80))
        return
