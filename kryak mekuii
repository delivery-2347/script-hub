    local function changeHumanoidState(hum, state)
        if not hum then return end
        pcall(function()
            hum:ChangeState(state)
            hum.PlatformStand = false
            hum.Sit = false
        end)
    end

    local lastProcessTime = 0
    local function antiGrabLogic()
        if not States.AntiGrab.cached.parts then return end
        if not States.AntiGrab.cached.parts.IsHeld then return end
        if not States.AntiGrab.cached.parts.Root or not States.AntiGrab.cached.parts.Root.Parent then return end
        if not States.AntiGrab.cached.parts.Humanoid or not States.AntiGrab.cached.parts.Humanoid.Parent then return end

        local now = tick()
        if now - lastProcessTime < States.AntiGrab.processInterval then return end
        lastProcessTime = now

        local held = false
        pcall(function()
            held = States.AntiGrab.cached.parts.IsHeld.Value
        end)
        if not held then return end

        local root = States.AntiGrab.cached.parts.Root
        local hum = States.AntiGrab.cached.parts.Humanoid
        local char = States.AntiGrab.cached.parts.Character
        if not char then return end

        changeHumanoidState(hum, Enum.HumanoidStateType.Running)

        local parts = getBodyParts(char)
        local head = char:FindFirstChild("Head")

